    "src/discovery.ts",
    "src/profile.ts",
    "src/editor.ts",
    "src/editor-input.ts",
    "src/media.ts",
    "src/server-drafts.ts",
    "src/messages.ts",
    "src/interests.ts",
    "src/refresh.ts",
    "src/main.ts"
